# Copy to .env and fill in. Never commit .env.

# --- MongoDB Atlas -------------------------------------------------------------
# Atlas UI > your cluster > Connect > Drivers. Add your IP (or 0.0.0.0/0 for a demo) to the Network Access list.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=coding_agent

# --- Voyage AI (embeddings + rerank) --------------------------------------------
# Key from dash.voyageai.com -> keep the default base URL.
# Key created in the Atlas UI (AI Models / API keys) -> VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
EMBED_MODEL=voyage-code-3
EMBED_DIMENSIONS=1024
# Leave empty to disable reranking.
RERANK_MODEL=rerank-2.5

# --- OpenAI --------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- GitLab (only needed for repos with `source: gitlab` in config/sources.yaml) -----
# Token needs read_api + read_repository. Use a dedicated read-only service account.
GITLAB_URL=
GITLAB_TOKEN=

# --- Behaviour -----------------------------------------------------------------
INGEST_INTERVAL_SECONDS=600
RETRIEVAL_TOP_K=8
# Append a "Sources" list to chat/explain answers in the IDE.
SOURCES_FOOTER=true
# Store the retrieval query text in usage events (off by default for privacy).
LOG_PROMPTS=false
EVENTS_TTL_DAYS=90
